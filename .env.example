# Copy to .env and replace the placeholder values. Never commit .env.
# Read by docker-compose.yml (POSTGRES_*) and by the Spring Boot backend (DB_*, SERVER_PORT, CORS_*).
POSTGRES_DB=campusconnect
POSTGRES_USER=campusconnect
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

DB_URL=jdbc:postgresql://localhost:5432/campusconnect
DB_USER=campusconnect
DB_PASSWORD=replace-with-a-local-password
DB_POOL_SIZE=10

SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Phase 2 (authentication) ---
# Set to true when the site is served over HTTPS so the session cookie is Secure.
SESSION_COOKIE_SECURE=false
# Optional: creates the FIRST Placement Admin at startup if none exists. Use a strong password (10-72 chars, letter + digit).
# Remove BOOTSTRAP_ADMIN_PASSWORD from .env after the first successful start.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Placement Administrator
# Optional tuning (defaults shown)
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
BCRYPT_STRENGTH=10
